[gd_resource type="Resource" script_class="TooltipIconCatalog" format=3]

[ext_resource type="Script" path="res://Scenes/GameUI/GraphicalUI/HUD/TooltipIconEntry.gd" id="1_entry"]
[ext_resource type="Texture2D" path="res://Scenes/GameUI/GraphicalUI/BattleScene/Assests/icon.svg" id="2_gloom"]
[ext_resource type="Texture2D" path="res://Scenes/GameUI/GraphicalUI/BattleScene/Assests/icon2.png" id="3_regen"]
[ext_resource type="Resource" path="res://Scenes/GameUI/GraphicalUI/BattleScene/Assests/IconTest.tres" id="4_cards"]
[ext_resource type="Resource" path="res://Scenes/GameUI/GraphicalUI/BattleScene/Assests/StatusIcons.tres" id="5_status"]
[ext_resource type="Script" path="res://Scenes/GameUI/GraphicalUI/HUD/TooltipIconCatalog.gd" id="6_catalog"]

[sub_resource type="Resource" id="Resource_gloom"]
script = ExtResource("1_entry")
id = "gloom"
display_name = "Gloom"
icon = ExtResource("2_gloom")
display_mode = 0
use_custom_color = true
keyword_color = Color(0.752941, 0.517647, 0.988235, 1)
bold_keyword = false
match_plain_keyword = true
aliases = PackedStringArray()
icon_size_override = 0

[sub_resource type="Resource" id="Resource_regeneration"]
script = ExtResource("1_entry")
id = "regeneration"
display_name = "Regeneration"
icon = ExtResource("3_regen")
display_mode = 0
use_custom_color = true
keyword_color = Color(0.431373, 0.905882, 0.717647, 1)
bold_keyword = false
match_plain_keyword = true
aliases = PackedStringArray()
icon_size_override = 0

[resource]
script = ExtResource("6_catalog")
default_icon_size = 16
entries = Array[TooltipIconEntry]([SubResource("Resource_gloom"), SubResource("Resource_regeneration")])
fallback_category_catalog = ExtResource("4_cards")
fallback_status_catalog = ExtResource("5_status")
