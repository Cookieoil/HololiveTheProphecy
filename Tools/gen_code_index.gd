extends SceneTree
## Headless symbol-index generator for this repository.
##
## Parses every first-party GDScript source and writes the navigation set that
## replaces reading the sources:
##
##   Docs/CODEBASE_MAP.md   slim overview (scripts, tests, EventBus, scenes, data)
##   Docs/symbols.tsv       flat symbol -> location table, one line per symbol
##   Docs/map/<file>.md     one detail page per script and per scene
##
## The overview stays small on purpose: it is the file a reader (or an agent)
## opens first, and the per-script detail lives in its own page so that reading
## one script's API never costs the whole codebase.
##
## res://addons/, res://Trash/, res://bin/, res://reports/ and res://.godot/ are
## ignored, as are files sitting directly in the project root, so only game code
## ends up in the index and the output is identical on every checkout.
##
## Usage:
##   godot --headless --path . --script res://Tools/gen_code_index.gd
##   godot --headless --path . --script res://Tools/gen_code_index.gd -- --check
##   godot --headless --path . --script res://Tools/gen_code_index.gd -- --output-dir res://reports/navigation-test
##
## --check never writes: it compares every artifact (including orphaned pages
## left behind by a deleted or renamed script) against a fresh in-memory
## generation, so a stale index fails a gate instead of silently lying.
## --output-dir redirects everything, which is how Tools/check_navigation.gd
## exercises the generator without touching the committed Docs/.
##
## All parsing lives in Tools/CodeIndexParser.gd (pure, unit tested by
## GDTest/CodeIndexTest.gd); this file only collects files, renders and writes.
##
## Exit code 0 = artifacts written (or already up to date), 1 = write failure,
## stale artifact or missing source.
##
## @author TheGreatJellyfish
## @version 11/18/2026

#region Constants
const ROOT_DIR: String = "res://"
## Default output; `--output-dir` overrides it (the test harness generates into
## res://reports/ so the committed Docs/ is never touched by a test run).
const DEFAULT_DOCS_DIR: String = "res://Docs"
const MAP_FILE_NAME: String = "CODEBASE_MAP.md"
const SYMBOLS_FILE_NAME: String = "symbols.tsv"
const MAP_DIR_NAME: String = "map"
const EVENT_BUS_PATH: String = "res://Managers/EventBus.gd"
const DATA_JSON_DIR: String = "res://Data/json"
const GENERATE_COMMAND: String = "godot --headless --path . --script res://Tools/gen_code_index.gd"
const ARG_CHECK: String = "--check"
const ARG_OUTPUT_DIR: String = "--output-dir"
const ENV_GITHUB_ACTIONS: String = "GITHUB_ACTIONS"

## First line of symbols.tsv: names the columns and states the convention.
const SYMBOLS_HEADER: String = "#name\tkind\tlocation\tdetail   (location is path:start-end, 1-based and inclusive; generated by Tools/gen_code_index.gd)"

## Folders that hold no first-party game code (vendor, scratch, generated output).
const EXCLUDED_DIRS: PackedStringArray = [
	"res://addons/",
	"res://.godot/",
	"res://reports/",
	"res://Trash/",
	"res://bin/",
]

## Only the overview needs a cap; everything else scales with the codebase.
const MAX_REGIONS_LISTED: int = 8
#endregion

#region Private Variables
var _script_paths: PackedStringArray = PackedStringArray()
var _scene_paths: PackedStringArray = PackedStringArray()
var _infos: Array[Dictionary] = []
var _texts: Dictionary = {}
var _class_names: PackedStringArray = PackedStringArray()
var _check_only: bool = false
var _docs_dir: String = DEFAULT_DOCS_DIR
#endregion

#region Lifecycle Methods
func _initialize() -> void:
	var user_args: PackedStringArray = OS.get_cmdline_user_args()
	_check_only = ARG_CHECK in user_args
	_docs_dir = _read_output_dir(user_args)
	_collect(ROOT_DIR, ".gd", _script_paths)
	_collect(ROOT_DIR, ".tscn", _scene_paths)
	_script_paths.sort()
	_scene_paths.sort()
	for path: String in _script_paths:
		var text: String = _normalized_text(path)
		_texts[path] = text
		var info: Dictionary = CodeIndexParser.parse_script(path, text)
		_infos.append(info)
		var class_value: String = CodeIndexParser.dict_string(info, "class_name")
		if not class_value.is_empty():
			_class_names.append(class_value)
	_class_names.sort()
	CodeIndexParser.apply_dependencies(_infos, _texts, _class_names)
	var global_signals: Array[Dictionary] = _collect_global_signals()
	var scenes: Array[Dictionary] = _collect_scenes()
	var data_files: Array[Dictionary] = _collect_data_files()
	var artifacts: Dictionary = _build_artifacts(global_signals, scenes, data_files)
	if _check_only:
		quit(_report_staleness(artifacts))
		return
	quit(_write_artifacts(artifacts))
#endregion

#region Private Methods
## `-- --output-dir res://somewhere` keeps tests out of the committed Docs/.
func _read_output_dir(user_args: PackedStringArray) -> String:
	for i: int in range(user_args.size()):
		if user_args[i] == ARG_OUTPUT_DIR and i + 1 < user_args.size():
			var requested: String = user_args[i + 1].strip_edges()
			if not requested.is_empty():
				return requested.trim_suffix("/")
	return DEFAULT_DOCS_DIR


func _map_path() -> String:
	return _docs_dir + "/" + MAP_FILE_NAME


func _symbols_path() -> String:
	return _docs_dir + "/" + SYMBOLS_FILE_NAME


func _map_dir() -> String:
	return _docs_dir + "/" + MAP_DIR_NAME


## res:// path -> file content, so --check and the writer share one source of
## truth and can never disagree about what "up to date" means.
func _build_artifacts(global_signals: Array[Dictionary], scenes: Array[Dictionary], data_files: Array[Dictionary]) -> Dictionary:
	var artifacts: Dictionary = {}
	var used_by: Dictionary = _build_used_by()
	for info: Dictionary in _infos:
		artifacts[_script_page_path(CodeIndexParser.dict_string(info, "path"))] = _render_script_page(info, used_by)
	for scene: Dictionary in scenes:
		artifacts[_scene_page_path(CodeIndexParser.dict_string(scene, "path"))] = _render_scene_page(scene)
	artifacts[_symbols_path()] = _render_symbols()
	artifacts[_map_path()] = _render_map(global_signals, scenes, data_files)
	return artifacts


func _collect(dir_path: String, extension: String, result: PackedStringArray) -> void:
	var dir: DirAccess = DirAccess.open(dir_path)
	if dir == null:
		return
	var base: String = dir_path if dir_path.ends_with("/") else dir_path + "/"
	# Files directly in res:// are skipped on purpose: the project root only ever
	# holds editor scratch saves (e.g. a stray scene copy), and indexing those
	# would make the generated index differ between checkouts.
	var skip_files: bool = dir_path == ROOT_DIR
	dir.list_dir_begin()
	var entry: String = dir.get_next()
	while entry != "":
		if dir.current_is_dir():
			var child: String = base + entry + "/"
			if not _is_excluded(child):
				_collect(child, extension, result)
		elif not skip_files and entry.ends_with(extension):
			result.append(base + entry)
		entry = dir.get_next()
	dir.list_dir_end()


func _is_excluded(dir_path: String) -> bool:
	# The output tree is never "excluded", even when --output-dir points inside
	# res://reports/: orphan detection and pruning have to walk it.
	if dir_path == _map_dir() or dir_path.begins_with(_map_dir() + "/"):
		return false
	for excluded: String in EXCLUDED_DIRS:
		if dir_path.begins_with(excluded):
			return true
	return false


func _normalized_text(res_path: String) -> String:
	return CodeIndexParser.normalized_text(FileAccess.get_file_as_string(res_path))


func _write_text(res_path: String, text: String) -> bool:
	var dir_path: String = res_path.get_base_dir()
	if not dir_path.is_empty():
		var dir_error: Error = DirAccess.make_dir_recursive_absolute(dir_path)
		if dir_error != OK and dir_error != ERR_ALREADY_EXISTS:
			printerr("[code-index] cannot create %s (error %d)" % [dir_path, dir_error])
			return false
	var file: FileAccess = FileAccess.open(res_path, FileAccess.WRITE)
	if file == null:
		printerr("[code-index] cannot write %s (error %d)" % [res_path, FileAccess.get_open_error()])
		return false
	file.store_string(text)
	file.close()
	return true


func _matches_artifact(res_path: String, expected: String) -> bool:
	if not FileAccess.file_exists(res_path):
		return false
	return _normalized_text(res_path) == expected


## Pages under Docs/map/ that belong to no current source file (deleted or
## renamed script), so a stale page can never be read as the truth.
func _orphan_pages(artifacts: Dictionary) -> PackedStringArray:
	var existing: PackedStringArray = PackedStringArray()
	_collect(_map_dir(), ".md", existing)
	var orphans: PackedStringArray = PackedStringArray()
	for res_path: String in existing:
		if not artifacts.has(res_path):
			orphans.append(res_path)
	orphans.sort()
	return orphans


func _report_staleness(artifacts: Dictionary) -> int:
	var stale: PackedStringArray = PackedStringArray()
	for res_path: String in artifacts:
		if not _matches_artifact(res_path, CodeIndexParser.dict_string(artifacts, res_path)):
			stale.append(CodeIndexParser.repo_path(res_path))
	for orphan: String in _orphan_pages(artifacts):
		stale.append(CodeIndexParser.repo_path(orphan) + " (orphaned page)")
	if stale.is_empty():
		print("[code-index] UP TO DATE: %d artifact(s) = %s + %s + %d page(s)" % [
			artifacts.size(),
			CodeIndexParser.repo_path(_map_path()),
			CodeIndexParser.repo_path(_symbols_path()),
			artifacts.size() - 2,
		])
		return 0
	var in_ci: bool = OS.get_environment(ENV_GITHUB_ACTIONS) == "true"
	for path_value: String in stale:
		printerr("[code-index] STALE: %s does not match the current sources" % path_value)
		if in_ci:
			printerr("::error file=%s,title=Code index::stale symbol index" % path_value)
	printerr("[code-index] regenerate with: %s" % GENERATE_COMMAND)
	return 1


func _write_artifacts(artifacts: Dictionary) -> int:
	for res_path: String in artifacts:
		if not _write_text(res_path, CodeIndexParser.dict_string(artifacts, res_path)):
			return 1
	for orphan: String in _orphan_pages(artifacts):
		var remove_error: Error = DirAccess.remove_absolute(orphan)
		if remove_error != OK:
			printerr("[code-index] cannot remove orphaned page %s (error %d)" % [orphan, remove_error])
			return 1
		print("[code-index] removed orphaned page %s" % CodeIndexParser.repo_path(orphan))
	_prune_empty_map_dirs()
	print("[code-index] wrote %s, %s and %d page(s) for %d script(s) and %d scene(s)" % [
		CodeIndexParser.repo_path(_map_path()),
		CodeIndexParser.repo_path(_symbols_path()),
		artifacts.size() - 2,
		_infos.size(),
		_scene_paths.size(),
	])
	return 0


## <docs dir>/map/Core/Card.gd -> <docs dir>/map/Core/Card.md
func _script_page_path(repo_path_value: String) -> String:
	return _map_dir() + "/" + CodeIndexParser.script_page_file(repo_path_value)


## <docs dir>/map/Scenes/.../BattleScene.tscn -> .../BattleScene.scene.md
func _scene_page_path(repo_path_value: String) -> String:
	return _map_dir() + "/" + CodeIndexParser.scene_page_file(repo_path_value)


## Link from a generated page back up to the map file, wherever the output went.
func _up_to_map_link(repo_path_value: String) -> String:
	var depth: int = repo_path_value.get_base_dir().count("/") + 2
	return "../".repeat(depth) + MAP_FILE_NAME


## Link from the map (which sits beside the map directory) to one of its pages.
func _map_link(page_res_path: String) -> String:
	return page_res_path.substr(_docs_dir.length() + 1)


## Deletes folders left empty under Docs/map/ after a page was orphaned, so a
## rename or a delete cannot leave a stray empty directory in the tree.
func _prune_empty_map_dirs() -> void:
	var dirs: PackedStringArray = PackedStringArray()
	_collect_dirs(_map_dir(), dirs)
	# Deepest first, so a parent only looks empty once its children are gone.
	dirs.reverse()
	for dir_path: String in dirs:
		var dir: DirAccess = DirAccess.open(dir_path)
		if dir == null:
			continue
		if dir.get_files().is_empty() and dir.get_directories().is_empty():
			DirAccess.remove_absolute(dir_path)


func _collect_dirs(dir_path: String, result: PackedStringArray) -> void:
	var dir: DirAccess = DirAccess.open(dir_path)
	if dir == null:
		return
	dir.list_dir_begin()
	var entry: String = dir.get_next()
	while entry != "":
		if dir.current_is_dir():
			var child: String = dir_path + "/" + entry
			result.append(child)
			_collect_dirs(child, result)
		entry = dir.get_next()
	dir.list_dir_end()


func _find_info(res_path: String) -> Dictionary:
	var wanted: String = CodeIndexParser.repo_path(res_path)
	for info: Dictionary in _infos:
		if CodeIndexParser.dict_string(info, "path") == wanted:
			return info
	return {}


func _render_symbols() -> String:
	var rows: PackedStringArray = PackedStringArray()
	for info: Dictionary in _infos:
		var path_value: String = CodeIndexParser.dict_string(info, "path")
		var class_value: String = CodeIndexParser.dict_string(info, "class_name")
		if not class_value.is_empty():
			var class_line: int = CodeIndexParser.dict_int(info, "class_line")
			_append_row(rows, _symbol_row(class_value, "class", path_value, class_line, class_line, "extends " + CodeIndexParser.dict_string(info, "extends")))
		for entry: Variant in CodeIndexParser.dict_array(info, "enums"):
			if not (entry is Dictionary):
				continue
			var enum_entry: Dictionary = entry
			var enum_line: int = CodeIndexParser.dict_int(enum_entry, "line")
			_append_row(rows, _symbol_row(
				CodeIndexParser.dict_string(enum_entry, "name"),
				"enum",
				path_value,
				enum_line,
				CodeIndexParser.dict_int(enum_entry, "end", enum_line),
				_join_paths(CodeIndexParser.dict_string_array(enum_entry, "values")),
			))
		_append_entry_rows(rows, CodeIndexParser.dict_array(info, "signals"), "signal", path_value, false)
		_append_entry_rows(rows, CodeIndexParser.dict_array(info, "constants"), "const", path_value, true)
		_append_entry_rows(rows, CodeIndexParser.dict_array(info, "exports"), "export", path_value, true)
		_append_entry_rows(rows, CodeIndexParser.dict_array(info, "onready"), "onready", path_value, false)
		_append_entry_rows(rows, CodeIndexParser.dict_array(info, "variables"), "var", path_value, true)
		_append_function_rows(rows, CodeIndexParser.dict_array(info, "functions"), path_value)
	rows.sort()
	return SYMBOLS_HEADER + "\n" + "\n".join(rows) + "\n"


func _append_entry_rows(rows: PackedStringArray, entries: Array, kind: String, path_value: String, with_value: bool) -> void:
	for entry: Variant in entries:
		if not (entry is Dictionary):
			continue
		var record: Dictionary = entry
		var line: int = CodeIndexParser.dict_int(record, "line")
		_append_row(rows, _symbol_row(CodeIndexParser.dict_string(record, "name"), kind, path_value, line, line, CodeIndexParser.declaration_detail(record, with_value)))


func _append_function_rows(rows: PackedStringArray, functions: Array, path_value: String) -> void:
	for entry: Variant in functions:
		if not (entry is Dictionary):
			continue
		var record: Dictionary = entry
		var start_line: int = CodeIndexParser.dict_int(record, "line")
		var detail: String = ""
		if CodeIndexParser.dict_bool(record, "static"):
			detail = "static "
		detail += "(" + CodeIndexParser.dict_string(record, "args") + ")"
		var returns_value: String = CodeIndexParser.dict_string(record, "returns")
		if not returns_value.is_empty():
			detail += " -> " + returns_value
		_append_row(rows, _symbol_row(
			CodeIndexParser.dict_string(record, "name"),
			"func",
			path_value,
			start_line,
			CodeIndexParser.dict_int(record, "end", start_line),
			detail,
		))


func _symbol_row(symbol: String, kind: String, path_value: String, start_line: int, end_line: int, detail: String) -> String:
	if symbol.is_empty():
		return ""
	var clean_detail: String = detail.replace("\t", " ").replace("\n", " ").strip_edges()
	return "%s\t%s\t%s:%d-%d\t%s" % [symbol, kind, path_value, start_line, end_line, clean_detail]


func _append_row(rows: PackedStringArray, row: String) -> void:
	if not row.is_empty():
		rows.append(row)


func _build_used_by() -> Dictionary:
	var table: Dictionary = {}
	for info: Dictionary in _infos:
		var path_value: String = CodeIndexParser.dict_string(info, "path")
		for used: String in CodeIndexParser.dict_string_array(info, "uses"):
			var existing: Variant = table.get(used, PackedStringArray())
			if not (existing is PackedStringArray):
				continue
			var users: PackedStringArray = existing
			if not users.has(path_value):
				users.append(path_value)
			table[used] = users
	return table


func _cell(text: String) -> String:
	return text.replace("|", "\\|").replace("\n", " ").strip_edges()


func _join_paths(values: PackedStringArray) -> String:
	if values.is_empty():
		return "—"
	return ", ".join(values)


func _compact_regions(regions: PackedStringArray) -> String:
	if regions.size() <= MAX_REGIONS_LISTED:
		return " · ".join(regions)
	var head: PackedStringArray = regions.slice(0, MAX_REGIONS_LISTED)
	return " · ".join(head) + " · (+%d more)" % [regions.size() - MAX_REGIONS_LISTED]


## Every EventBus signal with the scripts that emit it and the scripts that
## listen to it: the fastest way to see the blast radius of a signal change.
func _collect_global_signals() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var bus_info: Dictionary = _find_info(EVENT_BUS_PATH)
	if bus_info.is_empty():
		return result
	for declared: Variant in CodeIndexParser.dict_array(bus_info, "signals"):
		if not (declared is Dictionary):
			continue
		var signal_entry: Dictionary = declared
		var signal_name: String = CodeIndexParser.dict_string(signal_entry, "name")
		if signal_name.is_empty():
			continue
		var emitters: PackedStringArray = PackedStringArray()
		var listeners: PackedStringArray = PackedStringArray()
		var pattern: String = "EventBus." + signal_name
		for info: Dictionary in _infos:
			var path_value: String = CodeIndexParser.dict_string(info, "path")
			var text: String = CodeIndexParser.dict_string(_texts, "res://" + path_value)
			if not text.contains(pattern):
				continue
			if text.contains(pattern + ".emit("):
				emitters.append(path_value)
			if text.contains(pattern + ".connect("):
				listeners.append(path_value)
		result.append({
			"signal": signal_name,
			"args": CodeIndexParser.dict_string(signal_entry, "args"),
			"emitters": emitters,
			"listeners": listeners,
		})
	return result


## Scene summary plus its full node tree, so @onready paths and instanced scenes
## can be checked without opening the .tscn.
func _collect_scenes() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for res_path: String in _scene_paths:
		result.append(CodeIndexParser.parse_scene(res_path, _normalized_text(res_path)))
	return result


func _collect_data_files() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var paths: PackedStringArray = PackedStringArray()
	_collect(DATA_JSON_DIR, ".json", paths)
	paths.sort()
	for res_path: String in paths:
		result.append(CodeIndexParser.parse_data_file(res_path, _normalized_text(res_path)))
	return result

func _render_map(global_signals: Array[Dictionary], scenes: Array[Dictionary], data_files: Array[Dictionary]) -> String:
	var out: PackedStringArray = PackedStringArray()
	out.append("# Codebase Map — Hololive: The Prophecy")
	out.append("")
	out.append("<!-- GENERATED FILE: do not edit by hand. Produced by Tools/gen_code_index.gd from the first-party sources. -->")
	out.append("")
	out.append("Refresh after changing any first-party script, scene or data file:")
	out.append("")
	out.append("```powershell")
	out.append(GENERATE_COMMAND)
	out.append("```")
	out.append("")
	out.append("Staleness and correctness gate (run by Tools/preflight.ps1 and CI; it also checks coverage, ranges, links, scenes, signals and data, and prints the read-cost benchmark):")
	out.append("")
	out.append("```powershell")
	out.append("godot --headless --path . --script res://Tools/check_navigation.gd")
	out.append("```")
	out.append("")
	out.append("## How to use this map (overview here, details in their own page)")
	out.append("")
	out.append("- **Overview:** section 1 lists every game script, section 2 every test, each with `class_name`, size and role.")
	out.append("- **One script's API with line numbers:** open its page under `Docs/map/` (linked from sections 1 and 2).")
	out.append("- **One scene's node tree:** open `Docs/map/<scene>.scene.md` (linked from section 4).")
	out.append("- **Find a symbol:** `rg -n '^get_effective_value\\t' Docs/symbols.tsv` returns `path:start-end`; drop the `^name\\t` anchor to search loosely.")
	out.append("- **Impact of a change:** the `Uses` / `Used by` lines on a script's page, and the emit/listen table in section 3.")
	out.append("- **Balancing:** section 5 lists each JSON file's shape, entry count and keys, so the file rarely has to be opened.")
	out.append("- **Measure it:** `godot --headless --path . --script res://Tools/check_navigation.gd -- --benchmark` prints what each recipe costs to read.")
	out.append("")
	_append_script_table(out, "## 1. Game scripts at a glance", _game_infos())
	_append_script_table(out, "## 2. Tests at a glance", _test_infos())
	_append_signal_table(out, global_signals)
	_append_scene_table(out, scenes)
	_append_data_table(out, data_files)
	out.append("---")
	out.append("")
	out.append("Indexed %d script(s) (%d game, %d test), %d scene(s), %d data file(s)." % [
		_infos.size(),
		_game_infos().size(),
		_test_infos().size(),
		scenes.size(),
		data_files.size(),
	])
	return "\n".join(out) + "\n"


func _game_infos() -> Array[Dictionary]:
	return _infos_with_tests(false)


func _test_infos() -> Array[Dictionary]:
	return _infos_with_tests(true)


func _infos_with_tests(tests: bool) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for info: Dictionary in _infos:
		if CodeIndexParser.dict_string(info, "path").begins_with(CodeIndexParser.TEST_DIR_PREFIX) == tests:
			result.append(info)
	return result


func _append_script_table(out: PackedStringArray, title: String, infos: Array[Dictionary]) -> void:
	out.append("%s (%d)" % [title, infos.size()])
	out.append("")
	out.append("| Script | class_name | lines | role |")
	out.append("| --- | --- | --- | --- |")
	for info: Dictionary in infos:
		var path_value: String = CodeIndexParser.dict_string(info, "path")
		var class_value: String = CodeIndexParser.dict_string(info, "class_name")
		var class_cell: String = "—"
		if not class_value.is_empty():
			class_cell = "`" + class_value + "`"
		out.append("| [`%s`](%s) | %s | %d | %s |" % [
			path_value,
			_map_link(_script_page_path(path_value)),
			class_cell,
			CodeIndexParser.dict_int(info, "lines"),
			_cell(CodeIndexParser.overview_role(CodeIndexParser.script_role(info))),
		])
	out.append("")


func _render_script_page(info: Dictionary, used_by: Dictionary) -> String:
	var path_value: String = CodeIndexParser.dict_string(info, "path")
	var class_value: String = CodeIndexParser.dict_string(info, "class_name")
	var extends_value: String = CodeIndexParser.dict_string(info, "extends")
	var out: PackedStringArray = PackedStringArray()
	out.append("<!-- GENERATED FILE: do not edit by hand. Produced by Tools/gen_code_index.gd. -->")
	var title: String = "# `%s`" % path_value
	if not class_value.is_empty():
		title += " — `class_name %s`" % class_value
	if not extends_value.is_empty():
		title += " extends `%s`" % extends_value
	out.append(title)
	out.append("")
	out.append("`%d` lines · [back to the map](%s)" % [CodeIndexParser.dict_int(info, "lines"), _up_to_map_link(path_value)])
	out.append("")
	out.append("> " + _cell(CodeIndexParser.script_role(info)))
	var regions: PackedStringArray = CodeIndexParser.dict_string_array(info, "regions")
	if not regions.is_empty():
		out.append("")
		out.append("Sections: " + _compact_regions(regions))
	_append_enum_lines(out, CodeIndexParser.dict_array(info, "enums"))
	_append_inner_class_lines(out, CodeIndexParser.dict_array(info, "inner_classes"))
	_append_declarations(out, "Signals", CodeIndexParser.dict_array(info, "signals"), false)
	_append_declarations(out, "Constants", CodeIndexParser.dict_array(info, "constants"), true)
	_append_declarations(out, "Exports", CodeIndexParser.dict_array(info, "exports"), true)
	_append_declarations(out, "Onready", CodeIndexParser.dict_array(info, "onready"), false)
	_append_declarations(out, "State", CodeIndexParser.dict_array(info, "variables"), true)
	_append_functions(out, CodeIndexParser.dict_array(info, "functions"))
	_append_dependencies(out, info, used_by)
	return "\n".join(out) + "\n"


func _append_enum_lines(out: PackedStringArray, enums: Array) -> void:
	for entry: Variant in enums:
		if not (entry is Dictionary):
			continue
		var enum_entry: Dictionary = entry
		out.append("- L%s `enum %s` = %s" % [
			CodeIndexParser.line_range(enum_entry),
			CodeIndexParser.dict_string(enum_entry, "name"),
			_join_paths(CodeIndexParser.dict_string_array(enum_entry, "values")),
		])


func _append_inner_class_lines(out: PackedStringArray, inner_classes: Array) -> void:
	for entry: Variant in inner_classes:
		if not (entry is Dictionary):
			continue
		var inner: Dictionary = entry
		out.append("- L%d `class %s extends %s` (members are not indexed)" % [
			CodeIndexParser.dict_int(inner, "line"),
			CodeIndexParser.dict_string(inner, "name"),
			CodeIndexParser.dict_string(inner, "extends"),
		])


func _append_dependencies(out: PackedStringArray, info: Dictionary, used_by: Dictionary) -> void:
	out.append("")
	out.append("Uses: " + _join_paths(CodeIndexParser.dict_string_array(info, "uses")))
	out.append("Used by: " + _join_paths(CodeIndexParser.dict_string_array(used_by, CodeIndexParser.dict_string(info, "class_name"))))
	out.append("Loads: " + _join_paths(CodeIndexParser.dict_string_array(info, "refs")))
	out.append("")


## One page per scene: the node tree, so @onready paths and instanced scenes can
## be checked without opening the .tscn.
func _render_scene_page(scene: Dictionary) -> String:
	var path_value: String = CodeIndexParser.dict_string(scene, "path")
	var out: PackedStringArray = PackedStringArray()
	out.append("<!-- GENERATED FILE: do not edit by hand. Produced by Tools/gen_code_index.gd. -->")
	out.append("# `%s` — root `%s` (`%s`), %d nodes" % [
		path_value,
		CodeIndexParser.dict_string(scene, "root_name"),
		CodeIndexParser.dict_string(scene, "root_type"),
		CodeIndexParser.dict_int(scene, "nodes"),
	])
	out.append("")
	out.append("[back to the map](%s)" % _up_to_map_link(path_value))
	var script_value: String = CodeIndexParser.dict_string(scene, "script")
	if not script_value.is_empty():
		out.append("")
		out.append("Root script: `%s`" % script_value)
	out.append("")
	out.append("## Node tree")
	out.append("")
	for node: Variant in CodeIndexParser.dict_array(scene, "node_list"):
		if not (node is Dictionary):
			continue
		var record: Dictionary = node
		var label: String = CodeIndexParser.dict_string(record, "name")
		var type_value: String = CodeIndexParser.dict_string(record, "type")
		if not type_value.is_empty():
			label += " `" + type_value + "`"
		var instance_value: String = CodeIndexParser.dict_string(record, "instance")
		if not instance_value.is_empty():
			label += " instance of `" + instance_value + "`"
		var node_script: String = CodeIndexParser.dict_string(record, "script")
		if not node_script.is_empty():
			label += " — script `" + node_script + "`"
		out.append("  ".repeat(CodeIndexParser.dict_int(record, "depth")) + "- " + label)
	return "\n".join(out) + "\n"


func _append_declarations(out: PackedStringArray, label: String, entries: Array, with_value: bool) -> void:
	if entries.is_empty():
		return
	var parts: PackedStringArray = PackedStringArray()
	for entry: Variant in entries:
		if not (entry is Dictionary):
			continue
		var record: Dictionary = entry
		var text: String = _declaration_text(record, with_value)
		if not text.is_empty():
			parts.append(text)
	if parts.is_empty():
		return
	out.append("")
	out.append(label + ":")
	for part: String in parts:
		out.append("- " + part)


func _declaration_text(record: Dictionary, with_value: bool) -> String:
	var name_value: String = CodeIndexParser.dict_string(record, "name")
	if name_value.is_empty():
		return ""
	var text: String = "L%s `%s%s`" % [
		CodeIndexParser.line_range(record),
		name_value,
		CodeIndexParser.declaration_detail(record, with_value),
	]
	var doc_text: String = CodeIndexParser.dict_string(record, "doc")
	if not doc_text.is_empty():
		text += " — " + _cell(doc_text)
	return text


## Public functions keep their full signature; private ones are listed as
## `name + line` only, which is enough to jump straight to the implementation.
func _append_functions(out: PackedStringArray, functions: Array) -> void:
	if functions.is_empty():
		return
	var public_parts: PackedStringArray = PackedStringArray()
	var private_parts: PackedStringArray = PackedStringArray()
	for entry: Variant in functions:
		if not (entry is Dictionary):
			continue
		var record: Dictionary = entry
		var name_value: String = CodeIndexParser.dict_string(record, "name")
		if name_value.is_empty():
			continue
		if CodeIndexParser.dict_bool(record, "private"):
			private_parts.append("L%s `%s`" % [CodeIndexParser.line_range(record), name_value])
			continue
		var text: String = "L%s `" % CodeIndexParser.line_range(record)
		if CodeIndexParser.dict_bool(record, "static"):
			text += "static "
		text += name_value + "(" + CodeIndexParser.dict_string(record, "args") + ")"
		var returns_value: String = CodeIndexParser.dict_string(record, "returns")
		if not returns_value.is_empty():
			text += " -> " + returns_value
		text += "`"
		var doc_text: String = CodeIndexParser.dict_string(record, "doc")
		if not doc_text.is_empty():
			text += " — " + _cell(doc_text)
		public_parts.append(text)
	if not public_parts.is_empty():
		out.append("")
		out.append("Public API:")
		for part: String in public_parts:
			out.append("- " + part)
	if not private_parts.is_empty():
		out.append("")
		out.append("Private:")
		for part: String in private_parts:
			out.append("- " + part)


func _append_signal_table(out: PackedStringArray, global_signals: Array[Dictionary]) -> void:
	out.append("## 3. Global signals (Managers/EventBus.gd)")
	out.append("")
	if global_signals.is_empty():
		out.append("No EventBus signals indexed.")
		out.append("")
		return
	out.append("| signal | args | emitted by | listened by |")
	out.append("| --- | --- | --- | --- |")
	for entry: Dictionary in global_signals:
		out.append("| `%s` | %s | %s | %s |" % [
			CodeIndexParser.dict_string(entry, "signal"),
			_cell(CodeIndexParser.dict_string(entry, "args")),
			_cell(_join_paths(CodeIndexParser.dict_string_array(entry, "emitters"))),
			_cell(_join_paths(CodeIndexParser.dict_string_array(entry, "listeners"))),
		])
	out.append("")


func _append_scene_table(out: PackedStringArray, scenes: Array[Dictionary]) -> void:
	out.append("## 4. Scenes (%d)" % [scenes.size()])
	out.append("")
	out.append("Node trees live on each scene's page.")
	out.append("")
	out.append("| scene | root | nodes | script |")
	out.append("| --- | --- | --- | --- |")
	for entry: Dictionary in scenes:
		var path_value: String = CodeIndexParser.dict_string(entry, "path")
		var script_value: String = CodeIndexParser.dict_string(entry, "script")
		var script_cell: String = "—"
		if not script_value.is_empty():
			script_cell = "`" + script_value + "`"
		out.append("| [`%s`](%s) | %s `%s` | %d | %s |" % [
			path_value,
			_map_link(_scene_page_path(path_value)),
			CodeIndexParser.dict_string(entry, "root_name"),
			CodeIndexParser.dict_string(entry, "root_type"),
			CodeIndexParser.dict_int(entry, "nodes"),
			script_cell,
		])
	out.append("")


func _append_data_table(out: PackedStringArray, data_files: Array[Dictionary]) -> void:
	out.append("## 5. Game data (Data/json)")
	out.append("")
	out.append("| file | shape | entries | per-entry keys |")
	out.append("| --- | --- | --- | --- |")
	for entry: Dictionary in data_files:
		out.append("| `%s` | %s | %d | %s |" % [
			CodeIndexParser.dict_string(entry, "path"),
			CodeIndexParser.dict_string(entry, "shape"),
			CodeIndexParser.dict_int(entry, "entries"),
			_cell(_join_paths(CodeIndexParser.dict_string_array(entry, "keys"))),
		])
	out.append("")
	var root_lines: PackedStringArray = PackedStringArray()
	for entry: Dictionary in data_files:
		var root_keys: PackedStringArray = CodeIndexParser.dict_string_array(entry, "root_keys")
		if not root_keys.is_empty():
			root_lines.append("- `%s`: %s" % [CodeIndexParser.dict_string(entry, "path"), _join_paths(root_keys)])
	if not root_lines.is_empty():
		out.append("Top-level keys:")
		for line: String in root_lines:
			out.append(line)
		out.append("")
