{
"pot": false,
"paddingX": 2,
"paddingY": 2,
"edgePadding": true,
"duplicatePadding": false,
"rotation": false,
"minWidth": 16,
"minHeight": 16,
"maxWidth": 2048,
"maxHeight": 2048,
"square": false,
"stripWhitespaceX": false,
"stripWhitespaceY": false,
"alphaThreshold": 0,
"filterMin": "Linear",
"filterMag": "Linear",
"wrapX": "ClampToEdge",
"wrapY": "ClampToEdge",
"format": "RGBA8888",
"alias": true,
"outputFormat": "png",
"ignoreBlankImages": true,
"premultiplyAlpha": false,
"useIndexes": false,
"bleed": false,
"limitMemory": true,
"grid": false,
"packing": "rectangles",
"scale": [ 1 ],
"scaleSuffix": [ "" ],
"atlasExtension": ".atlas",
"prettyPrint": true
}
