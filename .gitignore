# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
export.cfg
export_presets.cfg
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Godot atomic-write temp files. Covers the editor's '~' backups and the
# scene/resource writer's leftovers (e.g. ~libspine_godot.dll~RF1a2b.TMP and
# BattleScene.tscn447100594.tmp). Both cases are matched, upper or lower.
~*
*.TMP
*.tmp

# Spine source projects (`<char_id>.spine`, `images/`, `audio/`). Kept out of the
# repo: the editor source is large and the game only loads the exports under
# Scenes/BattleUnit/Spine/. See Tools/spine/README.md.
SpineSource/

# Python bytecode from the Tools/ scripts (prepare_spine_portrait.py,
# rig_combat_actor.py, ...) — never commit it.
__pycache__/
*.pyc

# gdUnit4 test reports: regenerated on every test run, never commit them
reports/

# Secrets and signing material. Godot writes Android keystores, macOS/iOS signing
# identities and PCK encryption keys into export_presets.cfg (already ignored above)
# and .godot/export_credentials.cfg (covered by .godot/). These patterns are the belt
# to that braces: nothing here may ever be committed, and `git add .` must not pick
# one up because a folder was added by hand.
.env
.env.*
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.p8
*.mobileprovision
